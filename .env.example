# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
#
# BROWSER-VISIBLE (VITE_ prefix): safe by design. The anon key only grants what
# the database's Row Level Security allows.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# SERVER-ONLY: read by `api/*` and never bundled into the browser. In Vercel set
# these as Project Settings > Environment Variables WITHOUT the VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
CROMA_API_KEY=

# Optional ------------------------------------------------------------------
# Use an in-memory fake instead of the real Croma while testing the UX locally
# (no credits spent, no real bank password needed). Refused when
# VERCEL_ENV=production. Fake usernames: rechazado* -> bank rejects, duplicada*
# -> already connected, sincupo* -> no slots, ocupado* -> busy (429).
# CROMA_MODE=mock

# How many bank connections one user may hold (Croma allows only 5 per
# organization in total, so keep this at 1 until that cap is raised).
# BANK_MAX_CONNECTIONS_PER_USER=1

# Failed bank sign-ins allowed per user per hour before further attempts are blocked.
# BANK_MAX_REJECTED_PER_HOUR=5

# Salt for hashing client IPs into the audit log. Without it, no IP hash is stored.
# BANK_AUDIT_IP_SALT=
