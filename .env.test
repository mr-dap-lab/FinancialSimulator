# Vitest's default mode is "test", so this overrides .env for the test suite
# only. Keeping the access gate off here means the existing feature/a11y
# tests can keep rendering <App /> and finding the tab strip directly,
# without every one of them first having to sign in through the gate.
# Dedicated tests for the gate itself explicitly stub VITE_REQUIRE_LOGIN
# to "true" — see src/features/auth/__tests__/AccessGate.test.tsx.
VITE_REQUIRE_LOGIN=false
